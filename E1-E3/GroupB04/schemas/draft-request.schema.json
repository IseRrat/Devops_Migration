{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.nju.edu.cn/IseRrat/devops/devops_product/GroupB04/schemas/draft-request.schema.json",
  "title": "DRAFT job request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_type", "trace_id", "repository", "context_files", "build_command", "verify_command", "max_iterations", "timeout_seconds"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "job_type": {"const": "DRAFT"},
    "trace_id": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "context_files": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/repositoryPath"}},
    "build_command": {"type": "string", "minLength": 1},
    "verify_command": {"type": "string", "minLength": 1},
    "expected_stdout": {"type": "string"},
    "max_iterations": {"type": "integer", "minimum": 1, "maximum": 30},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800}
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]+$"
    }
  }
}
