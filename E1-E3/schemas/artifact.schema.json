{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.nju.edu.cn/IseRrat/devops/devops_product/schemas/artifact.schema.json",
  "title": "Shared immutable artifact reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["uri", "sha256"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "uri": {"type": "string", "pattern": "^artifact://[a-z0-9-]+/[A-Za-z0-9._-]+/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\r\\n]+$"},
    "media_type": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer_job_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
